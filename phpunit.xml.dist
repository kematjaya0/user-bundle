<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         stopOnFailure="false"
         cacheDirectory=".phpunit.cache">
    <php>
        <ini name="error_reporting" value="-1"/>
    </php>
    <testsuites>
        <testsuite name="UserBundle Test Suite">
            <directory>tests/</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
        <exclude>
            <file>src/Entity/KmjUserInterface.php</file>
            <file>src/Entity/ClientChangePasswordInterface.php</file>
            <file>src/Entity/ResettingPasswordInterface.php</file>
            <file>src/Repo/KmjUserRepoInterface.php</file>
            <file>src/Subscriber/UserTypeSubscriberInterface.php</file>
            <file>src/Subscriber/Builder/UserTypeSubscriberBuilderInterface.php</file>
            <file>src/Config/RoutingConfigurationFactoryInterface.php</file>
            <file>src/Resources/config/routing/all.php</file>
            <file>src/Resources/config/routing/user.php</file>
        </exclude>
    </source>
</phpunit>
