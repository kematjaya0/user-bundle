{
    "name": "kematjaya/user-bundle",
    "description": "User bundle for Symfony",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "kematjaya0",
            "email": "kematjaya0@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.4",
        "doctrine/common": "^3.5",
        "symfony/http-foundation": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/security-bundle": "^7.4",
        "symfony/twig-bundle": "^7.4",
        "symfony/form": "^7.4",
        "gregwar/captcha-bundle": "^2.1",
        "symfony/framework-bundle": "^7.4",
        "symfony/yaml": "^7.4",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/orm": "^3.7",
        "symfony/uid": "^7.4",
        "symfony/doctrine-bridge": "^7.4",
        "symfony/security-core": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/phpunit-bridge": "^7.4",
        "friendsofphp/php-cs-fixer": "^3.64",
        "rector/rector": "^2.0",
        "phpstan/phpstan": "^2.1",
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "symfony/var-dumper": "^7.4",
        "symfony/browser-kit": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Kematjaya\\UserBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kematjaya\\UserBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-text --coverage-filter src",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse",
        "rector-dry": "rector process --dry-run"
    }
}
